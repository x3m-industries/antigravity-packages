# Maintainer: Steven Ceuppens <packaging@x3m.industries>
pkgname=antigravity-bin
pkgver=2.23.0
pkgrel=1
pkgdesc="Google Antigravity Agent Hub (Antigravity 2.0) - Official Agent Platform (Native Binary)"
arch=('x86_64' 'aarch64')
url="https://antigravity.google"
license=('custom')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'alsa-lib' 'mesa' 'libxkbfile' 'xdg-utils')
optdepends=(
    'libsecret: Credential storage support'
)
provides=('antigravity')
conflicts=('antigravity')
options=('!strip')

# Sources point to latest cryptographically verified release binaries
source_x86_64=("antigravity-${pkgver}-x86_64.deb::https://github.com/x3m-industries/antigravity-packages/releases/latest/download/antigravity_2.23.0-5238607586394112_amd64.deb")
source_aarch64=("antigravity-${pkgver}-aarch64.deb::https://github.com/x3m-industries/antigravity-packages/releases/latest/download/antigravity_2.23.0-5238607586394112_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    # Extract debian data archive
    bsdtar -xf data.tar.* -C "${pkgdir}"

    # Enforce Chromium SUID sandbox permissions (04755 root:root)
    if [ -f "${pkgdir}/usr/share/antigravity/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/usr/share/antigravity/chrome-sandbox"
    fi

    # Ensure executable permissions on main binary and launcher
    chmod 0755 "${pkgdir}/usr/share/antigravity/antigravity"
    chmod 0755 "${pkgdir}/usr/bin/antigravity"
}
