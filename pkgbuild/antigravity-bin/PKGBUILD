# Maintainer: Steven Ceuppens <packaging@x3m.industries>
pkgname=antigravity-bin
pkgver=2.23.0
pkgrel=1
pkgdesc="Google Antigravity Agent Hub (Antigravity 2.0) - Official Agent Platform (Native Binary)"
arch=('x86_64' 'aarch64')
url="https://antigravity.google"
license=('custom')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'alsa-lib' 'mesa' 'libxkbfile' 'xdg-utils')
optdepends=(
    'libsecret: Credential storage support'
)
provides=('antigravity')
conflicts=('antigravity')
options=('!strip')

# Sources point to cryptographically verified release binaries
_reltag="v2.5.5-4923483625488384.3_hub-2.23.0-5238607586394112"
_debver="2.23.0-5238607586394112"
source_x86_64=("antigravity-${pkgver}-${pkgrel}-x86_64.deb::https://github.com/x3m-industries/antigravity-packages/releases/download/${_reltag}/antigravity_${_debver}_amd64.deb")
source_aarch64=("antigravity-${pkgver}-${pkgrel}-aarch64.deb::https://github.com/x3m-industries/antigravity-packages/releases/download/${_reltag}/antigravity_${_debver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    # Extract debian data archive
    bsdtar -xf data.tar.* -C "${pkgdir}"

    # Enforce Chromium SUID sandbox permissions (04755 root:root)
    if [ -f "${pkgdir}/usr/share/antigravity/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/usr/share/antigravity/chrome-sandbox"
    fi

    # Ensure executable permissions on real binary (do not chmod /usr/bin symlink)
    if [ -f "${pkgdir}/usr/share/antigravity/antigravity" ]; then
        chmod 0755 "${pkgdir}/usr/share/antigravity/antigravity"
    fi
}
