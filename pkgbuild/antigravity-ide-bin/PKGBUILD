# Maintainer: Steven Ceuppens <packaging@x3m.industries>
pkgname=antigravity-ide-bin
pkgver=2.5.5
pkgrel=1
pkgdesc="Google Antigravity IDE - Official AI-First Desktop Code Editor (Native Binary)"
arch=('x86_64' 'aarch64')
url="https://antigravity.google"
license=('custom')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'alsa-lib' 'mesa' 'libxkbfile' 'xdg-utils')
optdepends=(
    'libsecret: Credential storage support'
    'nautilus-python: GNOME Files right-click context menu'
)
provides=('antigravity-ide')
conflicts=('antigravity-ide')
options=('!strip')

# Sources point to cryptographically verified release binaries
_reltag="v2.5.5-4923483625488384.3_hub-2.24.0-5780333019398144"
_debver="2.5.5-4923483625488384.3"
source_x86_64=("antigravity-ide-${pkgver}-${pkgrel}-x86_64.deb::https://github.com/x3m-industries/antigravity-packages/releases/download/${_reltag}/antigravity-ide_${_debver}_amd64.deb")
source_aarch64=("antigravity-ide-${pkgver}-${pkgrel}-aarch64.deb::https://github.com/x3m-industries/antigravity-packages/releases/download/${_reltag}/antigravity-ide_${_debver}_arm64.deb")
sha256sums_x86_64=('9484a7614aa17a8a4852ecdf3ec752f2fffe42e89690e7fb7e7fe792e4548800')
sha256sums_aarch64=('f2fdb981eaf15de94971b56e3c9902c8717fd072c3b656b4faa1a051b4162aca')

package() {
    # Extract debian data archive
    bsdtar -xf data.tar.* -C "${pkgdir}"

    # Enforce Chromium SUID sandbox permissions (04755 root:root)
    if [ -f "${pkgdir}/usr/share/antigravity-ide/chrome-sandbox" ]; then
        chmod 4755 "${pkgdir}/usr/share/antigravity-ide/chrome-sandbox"
    fi

    # Ensure executable permissions on real binaries (do not chmod /usr/bin symlinks)
    if [ -f "${pkgdir}/usr/share/antigravity-ide/antigravity-ide" ]; then
        chmod 0755 "${pkgdir}/usr/share/antigravity-ide/antigravity-ide"
    fi
    if [ -f "${pkgdir}/usr/share/antigravity-ide/bin/antigravity-ide" ]; then
        chmod 0755 "${pkgdir}/usr/share/antigravity-ide/bin/antigravity-ide"
    fi
}
