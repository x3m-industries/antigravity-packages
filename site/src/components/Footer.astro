---
import { siteConfig } from '../data/siteConfig';

interface Props {
  currentPage?: 'home' | 'docs';
}

const { currentPage = 'home' } = Astro.props;
const isHome = currentPage === 'home';
---

<footer>
  <p>
    Architected &amp; maintained by <strong><a href={siteConfig.author.linkedin} target="_blank" rel="noopener noreferrer">Steven Ceuppens</a></strong> at <a href={siteConfig.author.url} target="_blank" rel="noopener noreferrer"><strong>X3M Industries</strong></a> · GPG Key: <code style="font-family:'JetBrains Mono',monospace; background:rgba(0,0,0,0.35); padding:2px 6px; border-radius:4px; font-size:0.82rem; color:var(--accent);">{siteConfig.gpg.fingerprint}</code>
  </p>
  <p class="footer-links">
    {isHome ? (
      <a href="docs.html">Documentation &amp; Reference</a>
    ) : (
      <a href="index.html">Main Website</a>
    )} · 
    <a href={siteConfig.repo.githubUrl} target="_blank" rel="noopener noreferrer">GitHub Repository</a> · 
    <a href="llms.txt">LLM Index</a> · 
    <a href="install.sh">install.sh</a>
  </p>
  <p class="footer-disclaimer">
    Google and Antigravity are trademarks of Google LLC. This is an open-source community distribution project and is not affiliated with Google.
  </p>
</footer>
