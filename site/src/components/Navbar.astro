---
import { siteConfig } from '../data/siteConfig';

interface Props {
  currentPage?: 'home' | 'docs';
}

const { currentPage = 'home' } = Astro.props;
const isDocs = currentPage === 'docs';
---

<nav class="site-nav" aria-label="Main Navigation">
  <div class="nav-inner">
    <a href="index.html" class="nav-brand" aria-label="Antigravity Linux Home">
      <img src="assets/logo.png" alt="Antigravity Logo" width="28" height="28" />
      <span>Antigravity Linux</span>
      {isDocs && <span class="nav-brand-badge">Docs</span>}
    </a>
    <div class="nav-links">
      {isDocs ? (
        <>
          <a href="index.html" class="nav-link">← Quickstart</a>
          <a href="#cli-reference" class="nav-link">CLI Options</a>
          <a href="#manual-repos" class="nav-link">Manual Repos</a>
          <a href="#nautilus" class="nav-link">GNOME Files</a>
          <a href="#security" class="nav-link">GPG Security</a>
          <a href="#faq" class="nav-link">Full FAQ</a>
        </>
      ) : (
        <>
          <a href="#quickstart" class="nav-link">Quickstart</a>
          <a href="#features" class="nav-link">Features</a>
          <a href="#why-native" class="nav-link">Why Native?</a>
          <a href="#faq" class="nav-link">FAQ</a>
          <a href="docs.html#manual-repos" class="nav-link" style="color:var(--accent); font-weight:600;">Manual Repos ↗</a>
          <a href="docs.html" class="nav-link" style="color:var(--accent); font-weight:600;">Docs &amp; CLI ↗</a>
        </>
      )}
      <a href={siteConfig.repo.githubUrl} target="_blank" rel="noopener noreferrer" class="nav-btn" aria-label="GitHub Repository">
        <span>GitHub</span>
        <span>★</span>
      </a>
    </div>
  </div>
</nav>
