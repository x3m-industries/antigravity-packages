---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, currentVersions, type PageId, type FaqItem, type HowToSchema } from '../data/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPage?: PageId;
  canonicalUrl?: string;
  breadcrumbLabel?: string;
  keywords?: string;
  faqs?: FaqItem[];
  howTo?: HowToSchema;
}

const defaultBreadcrumbs: Record<PageId, string> = {
  home: 'Home',
  docs: 'Documentation & CLI Reference',
  arch: 'Arch Linux (pacman, PKGBUILD & CLI)',
  uninstall: 'Uninstall Guide (Ubuntu & Linux)',
  opensuse: 'openSUSE (Tumbleweed & Leap Zypper)',
  fedora: 'Fedora, RHEL & Rocky Linux (DNF)',
  ubuntu: 'Ubuntu, Debian & Mint (APT)',
};

const {
  title = siteConfig.title,
  description = siteConfig.description,
  currentPage = 'home',
  canonicalUrl = currentPage === 'home'
    ? siteConfig.siteUrl
    : `${siteConfig.siteUrl}${currentPage}.html`,
  breadcrumbLabel = defaultBreadcrumbs[currentPage],
  keywords = siteConfig.defaultKeywords,
  faqs = currentPage === 'docs' ? siteConfig.docsFaqs : siteConfig.homeFaqs,
  howTo,
} = Astro.props;

const cleanHtml = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]*>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();

const defaultHowTo: HowToSchema = currentPage === 'home'
  ? {
      name: 'How to Install Google Antigravity on Linux',
      description:
        "Step-by-step guide to installing Google Antigravity 2.0, Antigravity IDE, and Antigravity CLI ('agy') on Fedora, Ubuntu, Debian, Arch Linux, and openSUSE.",
      steps: [
        {
          name: 'Run Universal Detection Command',
          text: 'Open your terminal and run the universal 1-line installer script: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash',
          url: `${siteConfig.siteUrl}#quickstart`,
        },
        {
          name: 'Select Components',
          text: "Choose to install Antigravity IDE (AI code editor), Antigravity App (Agent 2.0 platform), or the standalone Antigravity CLI ('agy').",
          url: `${siteConfig.siteUrl}#quickstart`,
        },
        {
          name: 'Launch Antigravity',
          text: "Launch your applications using application menu shortcuts or quick terminal commands: 'agy-ide', 'agy-app', or 'agy'.",
          url: `${siteConfig.siteUrl}docs.html#cli-reference`,
        },
      ],
    }
  : {
      name: 'How to Install or Uninstall Google Antigravity on Linux',
      description:
        "Reference commands for installing Antigravity CLI ('agy') and desktop packages on Arch Linux (PKGBUILD / pacman), Ubuntu/Debian (APT), Fedora (DNF), openSUSE (Zypper), and cleanly uninstalling.",
      steps: [
        {
          name: 'Install on Arch Linux (CLI or PKGBUILD)',
          text: 'Install the user-space CLI via: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --cli-only, or build desktop packages with makepkg -si from pkgbuild/.',
          url: `${siteConfig.siteUrl}arch.html`,
        },
        {
          name: 'Install on Ubuntu/Debian (APT), Fedora (DNF), or openSUSE (Zypper)',
          text: 'Configure the signed APT DEB822 or RPM repository (apt.x3m.industries / rpm.x3m.industries) and install antigravity-ide and antigravity.',
          url: `${siteConfig.siteUrl}docs.html#manual-repos`,
        },
        {
          name: 'Cleanly Uninstall Antigravity',
          text: 'Remove packages, repositories, and CLI shortcuts cleanly with: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --uninstall.',
          url: `${siteConfig.siteUrl}uninstall.html`,
        },
      ],
    };

const resolvedHowTo = howTo || defaultHowTo;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Google Antigravity Linux Packages',
      applicationCategory: 'DeveloperApplication',
      operatingSystem:
        'Linux (Fedora, Ubuntu, Debian, Arch Linux, openSUSE, RHEL, CentOS Stream, Rocky Linux, AlmaLinux, Pop!_OS, Linux Mint, CachyOS, Manjaro)',
      softwareVersion: `${currentVersions.ideSemver} (IDE) / ${currentVersions.hubSemver} (App)`,
      downloadUrl: siteConfig.repo.releasesUrl,
      url: siteConfig.siteUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      publisher: {
        '@type': 'Organization',
        name: 'X3M Industries',
        url: 'https://x3m.industries',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Google Antigravity IDE (antigravity-ide)',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux (x86_64, aarch64)',
      softwareVersion: currentVersions.ideSemver,
      downloadUrl: siteConfig.repo.releasesUrl,
      url: siteConfig.siteUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Google Antigravity App (antigravity)',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux (x86_64, aarch64)',
      softwareVersion: currentVersions.hubSemver,
      downloadUrl: siteConfig.repo.releasesUrl,
      url: siteConfig.siteUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'WebSite',
      name: 'Google Antigravity Linux Packages & Repositories',
      url: siteConfig.siteUrl,
      description: siteConfig.description,
      publisher: {
        '@type': 'Organization',
        name: 'X3M Industries',
        url: 'https://x3m.industries',
      },
    },
    ...(faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faqs.map((faq) => ({
              '@type': 'Question',
              name: faq.q,
              acceptedAnswer: {
                '@type': 'Answer',
                text: cleanHtml(faq.a),
              },
            })),
          },
        ]
      : []),
    {
      '@type': 'HowTo',
      name: resolvedHowTo.name,
      description: resolvedHowTo.description,
      totalTime: 'PT2M',
      step: resolvedHowTo.steps.map((step) => ({
        '@type': 'HowToStep',
        name: step.name,
        text: step.text,
        url: step.url,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteConfig.siteUrl,
        },
        ...(currentPage !== 'home'
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: breadcrumbLabel,
                item: canonicalUrl,
              },
            ]
          : []),
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXTD2B1XB0"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
      gtag('config', 'G-XXTD2B1XB0');
    }
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={siteConfig.author.name} />
  <meta name="google-site-verification" content="google676aa476e852c7b0" />
  <link rel="author" href={siteConfig.author.linkedin} />
  <link rel="me" href={siteConfig.author.linkedin} />
  <link rel="me" href={siteConfig.author.x} />
  <link rel="me" href={siteConfig.author.github} />
  <link rel="me" href={siteConfig.author.url} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="text/plain" href="llms.txt" title="LLM Context" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="sitemap.xml" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Favicon & Icons -->
  <link rel="icon" type="image/png" href="favicon.png" />
  <link rel="apple-touch-icon" href="favicon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Google Antigravity Linux Repositories" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />
  <meta property="og:image:secure_url" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Google Antigravity IDE, App, and CLI for Linux — Native Packages" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@stevenceuppens" />
  <meta name="twitter:site" content="@stevenceuppens" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />

  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <Navbar currentPage={currentPage} />
  <div class="container">
    <slot />
    <Footer currentPage={currentPage} />
  </div>
  <script is:inline>
    window.copyCode = function(btn) {
      const container = btn.closest('.code-block');
      const codeEl = container ? container.querySelector('code') : null;
      const code = codeEl ? codeEl.innerText.trim() : '';
      if (!code) return;

      navigator.clipboard.writeText(code).then(() => {
        btn.classList.add('copied');
        btn.setAttribute('title', 'Copied to clipboard!');
        btn.setAttribute('aria-label', 'Copied to clipboard!');
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.setAttribute('title', 'Copy to clipboard');
          btn.setAttribute('aria-label', 'Copy to clipboard');
        }, 2000);

        if (typeof gtag === 'function') {
          const section = btn.closest('.doc-section');
          const secId = section && section.id ? section.id : window.location.pathname.split('/').pop() || 'docs';
          gtag('event', 'copy_docs_command', {
            event_category: 'conversion',
            event_label: secId,
            command: code
          });
          gtag('event', 'copy_docs_' + secId.replace(/[^a-z0-9_]/gi, '_'), {
            event_category: 'conversion',
            event_label: secId
          });
        }
      }).catch(err => console.error('Copy failed: ', err));
    };

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('details.faq-item').forEach((detailsEl) => {
        detailsEl.addEventListener('toggle', () => {
          if (detailsEl.open && typeof gtag === 'function') {
            const summary = detailsEl.querySelector('summary');
            const question = summary ? summary.textContent.trim() : 'faq';
            gtag('event', 'toggle_faq', {
              event_category: 'engagement',
              event_label: question
            });
          }
        });
      });

      document.addEventListener('click', (e) => {
        const link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!link || typeof gtag !== 'function') return;
        const href = link.getAttribute('href') || '';
        if (href.includes('github.com/x3m-industries/antigravity-packages/releases')) {
          gtag('event', 'click_github_releases', {
            event_category: 'conversion',
            event_label: href
          });
        } else if (href.includes('github.com/x3m-industries/antigravity-packages/tree/main/pkgbuild')) {
          gtag('event', 'click_arch_pkgbuild', {
            event_category: 'conversion',
            event_label: href
          });
        } else if (href.includes('github.com/x3m-industries/antigravity-packages')) {
          gtag('event', 'click_github_repo', {
            event_category: 'engagement',
            event_label: href
          });
        } else if (/^https?:\/\//.test(href) && !href.includes('x3m-industries.github.io')) {
          gtag('event', 'click_outbound', {
            event_category: 'engagement',
            event_label: href
          });
        }
      });
    });
  </script>
</body>
</html>
