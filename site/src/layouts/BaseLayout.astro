---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, currentVersions } from '../data/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPage?: 'home' | 'docs';
  canonicalUrl?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  currentPage = 'home',
  canonicalUrl = currentPage === 'docs'
    ? `${siteConfig.siteUrl}docs.html`
    : siteConfig.siteUrl,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Google Antigravity Linux Packages",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux (Fedora, Ubuntu, Debian, Arch Linux, openSUSE, RHEL, CentOS Stream, Rocky Linux, AlmaLinux, Pop!_OS, Linux Mint)",
      "softwareVersion": `${currentVersions.ideSemver} (IDE) / ${currentVersions.hubSemver} (Hub)`,
      "downloadUrl": siteConfig.repo.releasesUrl,
      "url": siteConfig.siteUrl,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "publisher": {
        "@type": "Organization",
        "name": "X3M Industries",
        "url": "https://x3m.industries",
      },
    },
    {
      "@type": "SoftwareApplication",
      "name": "Google Antigravity IDE (antigravity-ide)",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux (x86_64, aarch64)",
      "softwareVersion": currentVersions.ideSemver,
      "downloadUrl": siteConfig.repo.releasesUrl,
      "url": siteConfig.siteUrl,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
    },
    {
      "@type": "SoftwareApplication",
      "name": "Google Antigravity Agent Hub (antigravity)",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux (x86_64, aarch64)",
      "softwareVersion": currentVersions.hubSemver,
      "downloadUrl": siteConfig.repo.releasesUrl,
      "url": siteConfig.siteUrl,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
    },
    {
      "@type": "WebSite",
      "name": "Google Antigravity Linux Repositories",
      "url": siteConfig.siteUrl,
      "description": siteConfig.description,
      "publisher": {
        "@type": "Organization",
        "name": "X3M Industries",
        "url": "https://x3m.industries",
      },
    },
    {
      "@type": "FAQPage",
      "mainEntity": (currentPage === 'docs' ? siteConfig.docsFaqs : siteConfig.homeFaqs).map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
            .replace(/<br\s*\/?>/gi, " ")
            .replace(/<[^>]*>/g, "")
            .replace(/&amp;/g, "&")
            .replace(/&lt;/g, "<")
            .replace(/&gt;/g, ">")
            .replace(/&quot;/g, '"')
            .replace(/&#39;/g, "'")
            .replace(/\s+/g, " ")
            .trim(),
        },
      })),
    },
    ...(currentPage === 'home' ? [{
      "@type": "HowTo",
      "name": "How to Install Google Antigravity on Linux",
      "description": "Step-by-step guide to installing Google Antigravity 2.0, Antigravity IDE, and Antigravity CLI ('agy') on Fedora, Ubuntu, Debian, Arch Linux, and openSUSE.",
      "totalTime": "PT2M",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Run Universal Detection Command",
          "text": "Open your terminal and run the universal 1-line installer script: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash",
          "url": `${siteConfig.siteUrl}#quickstart`
        },
        {
          "@type": "HowToStep",
          "name": "Select Components",
          "text": "Choose to install Antigravity IDE (AI code editor), Antigravity Hub (Agent 2.0 platform), or the standalone Antigravity CLI ('agy').",
          "url": `${siteConfig.siteUrl}#quickstart`
        },
        {
          "@type": "HowToStep",
          "name": "Launch Antigravity",
          "text": "Launch your applications using application menu shortcuts or quick terminal commands: 'agy-ide', 'agy-hub', or 'agy'.",
          "url": `${siteConfig.siteUrl}docs.html#cli-reference`
        }
      ]
    }] : [{
      "@type": "HowTo",
      "name": "How to Install or Uninstall Google Antigravity on Arch Linux, Ubuntu, and Fedora",
      "description": "Reference commands for installing Antigravity CLI ('agy') and desktop packages on Arch Linux (PKGBUILD / pacman), Ubuntu/Debian (APT), Fedora (DNF), and cleanly uninstalling.",
      "totalTime": "PT2M",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Install on Arch Linux (CLI or PKGBUILD)",
          "text": "Install the user-space CLI via: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --cli-only, or build desktop packages with makepkg -si from pkgbuild/.",
          "url": `${siteConfig.siteUrl}docs.html#arch`
        },
        {
          "@type": "HowToStep",
          "name": "Install on Ubuntu/Debian (APT) or Fedora (DNF)",
          "text": "Configure the signed APT DEB822 or DNF repository and install via sudo apt install antigravity-ide antigravity or sudo dnf install antigravity-ide antigravity.",
          "url": `${siteConfig.siteUrl}docs.html#manual-repos`
        },
        {
          "@type": "HowToStep",
          "name": "Cleanly Uninstall Antigravity",
          "text": "Remove packages, repositories, and CLI shortcuts cleanly with: curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --uninstall.",
          "url": `${siteConfig.siteUrl}docs.html#maintenance`
        }
      ]
    }]),
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteConfig.siteUrl
        },
        ...(currentPage === 'docs' ? [{
          "@type": "ListItem",
          "position": 2,
          "name": "Documentation & CLI Reference",
          "item": `${siteConfig.siteUrl}docs.html`
        }] : [])
      ]
    }
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXTD2B1XB0"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
      gtag('config', 'G-XXTD2B1XB0');
    }
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Google Antigravity, Antigravity Linux, Antigravity IDE, Antigravity RPM, Antigravity DEB, Antigravity Fedora DNF, Antigravity Ubuntu PPA, Antigravity Ubuntu APT, Antigravity openSUSE, Antigravity openSUSE Zypper, Antigravity Arch Linux, Fedora Antigravity, Ubuntu Antigravity, Debian Antigravity, Arch Linux Antigravity, RHEL Antigravity, google antigravity rpm, antigravity fedora, fedora antigravity, antigravity apt, how to update antigravity ide in ubuntu, download antigravity linux, google antigravity download linux, install google antigravity, how to uninstall antigravity from ubuntu, uninstall antigravity ubuntu, uninstall antigravity in linux, remove antigravity completely ubuntu, antigravity cli arch, arch antigravity cli, pacman antigravity, yay antigravity, AI code editor, DeepMind Antigravity, DNF repository, APT repository, Zypper repository, x86_64, aarch64, arm64, AUR antigravity, antigravity 2.0 linux" />
  <meta name="author" content={siteConfig.author.name} />
  <meta name="google-site-verification" content="google676aa476e852c7b0" />
  <link rel="author" href={siteConfig.author.linkedin} />
  <link rel="me" href={siteConfig.author.linkedin} />
  <link rel="me" href={siteConfig.author.x} />
  <link rel="me" href={siteConfig.author.github} />
  <link rel="me" href={siteConfig.author.url} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="text/plain" href="llms.txt" title="LLM Context" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="sitemap.xml" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Favicon & Icons -->
  <link rel="icon" type="image/png" href="favicon.png" />
  <link rel="apple-touch-icon" href="favicon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Google Antigravity Linux Repositories" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />
  <meta property="og:image:secure_url" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Google Antigravity IDE, Hub, and CLI for Linux — Native Packages" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@stevenceuppens" />
  <meta name="twitter:site" content="@stevenceuppens" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://x3m-industries.github.io/antigravity-packages/assets/og-banner.png" />

  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <Navbar currentPage={currentPage} />
  <div class="container">
    <slot />
    <Footer currentPage={currentPage} />
  </div>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('details.faq-item').forEach((detailsEl) => {
        detailsEl.addEventListener('toggle', () => {
          if (detailsEl.open && typeof gtag === 'function') {
            const summary = detailsEl.querySelector('summary');
            const question = summary ? summary.textContent.trim() : 'faq';
            gtag('event', 'toggle_faq', {
              event_category: 'engagement',
              event_label: question
            });
          }
        });
      });

      document.addEventListener('click', (e) => {
        const link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!link || typeof gtag !== 'function') return;
        const href = link.getAttribute('href') || '';
        if (href.includes('github.com/x3m-industries/antigravity-packages/releases')) {
          gtag('event', 'click_github_releases', {
            event_category: 'conversion',
            event_label: href
          });
        } else if (href.includes('github.com/x3m-industries/antigravity-packages/tree/main/pkgbuild')) {
          gtag('event', 'click_arch_pkgbuild', {
            event_category: 'conversion',
            event_label: href
          });
        } else if (href.includes('github.com/x3m-industries/antigravity-packages')) {
          gtag('event', 'click_github_repo', {
            event_category: 'engagement',
            event_label: href
          });
        } else if (/^https?:\/\//.test(href) && !href.includes('x3m-industries.github.io')) {
          gtag('event', 'click_outbound', {
            event_category: 'engagement',
            event_label: href
          });
        }
      });
    });
  </script>
</body>
</html>
