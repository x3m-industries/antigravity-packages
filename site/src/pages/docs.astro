---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title="Documentation & CLI Reference — Google Antigravity for Linux"
  description="Complete documentation, command-line reference, manual repository setup, GPG verification, and troubleshooting for Google Antigravity on Linux."
  currentPage="docs"
>
  <!-- Documentation Header -->
  <header class="doc-header">
    <div class="doc-breadcrumb">
      <a href="index.html">Home</a>
      <span>/</span>
      <span>Documentation &amp; Reference</span>
    </div>
    <h1 class="doc-title">Developer &amp; Enterprise Documentation</h1>
    <p class="doc-subtitle">Exhaustive command-line parameters, manual repository setup without curl scripts, GNOME Files integration internals, and cryptographic security verification.</p>
  </header>

  <!-- Quick Jump Bar -->
  <nav class="toc-bar" aria-label="Table of contents">
    <a href="#cli-reference" class="toc-link">⚡ CLI Options Reference</a>
    <a href="#maintenance" class="toc-link">🔍 Status &amp; Uninstall</a>
    <a href="#manual-repos" class="toc-link">🐧 Manual Repositories</a>
    <a href="#nautilus" class="toc-link">📂 GNOME Files (Nautilus)</a>
    <a href="#arch" class="toc-link">🏹 Arch Linux Setup</a>
    <a href="#security" class="toc-link">🔐 GPG Verification</a>
    <a href="#faq" class="toc-link">❓ Complete FAQ Archive</a>
  </nav>

  <main id="main-content">
    <!-- Section 1: Universal Installer CLI Reference -->
    <section class="doc-section" id="cli-reference">
      <h2 class="section-heading"><span>⚡</span> Universal Installer CLI Reference</h2>
      <p class="section-desc">The universal installer script (<code>install.sh</code>) accepts command-line parameters for unattended CI/CD automation, component selection, diagnostic inspection, and clean uninstallation.</p>

      <div class="table-wrapper">
        <table class="doc-table">
          <thead>
            <tr>
              <th>Flag</th>
              <th>Description</th>
              <th>Privileges</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>-y</code>, <code>--yes</code>, <code>--non-interactive</code></td>
              <td>Run silently without interactive prompts (installs IDE, Hub, CLI)</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--all</code></td>
              <td>Explicitly install all three components (IDE, Hub, CLI)</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--cli-only</code></td>
              <td>Install only the Antigravity CLI (<code>agy</code>) in <code>~/.local/bin/agy</code></td>
              <td><span class="badge-pill user">User-Space (No sudo)</span></td>
            </tr>
            <tr>
              <td><code>--ide-only</code></td>
              <td>Install only the Antigravity IDE (code editor) via RPM/DEB</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--hub-only</code></td>
              <td>Install only the Antigravity Hub (agent platform) via RPM/DEB</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--no-cli</code></td>
              <td>Skip Antigravity CLI installation (desktop packages only)</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--no-ide</code></td>
              <td>Skip Antigravity IDE installation</td>
              <td><span class="badge-pill root">Sudo / User</span></td>
            </tr>
            <tr>
              <td><code>--no-hub</code></td>
              <td>Skip Antigravity Hub installation</td>
              <td><span class="badge-pill root">Sudo / User</span></td>
            </tr>
            <tr>
              <td><code>--status</code></td>
              <td>Inspect installed components, versions, repo status, and integrations</td>
              <td><span class="badge-pill free">Zero privileges</span></td>
            </tr>
            <tr>
              <td><code>--print-downloads</code></td>
              <td>Print official Google tarballs &amp; repository asset URLs</td>
              <td><span class="badge-pill free">Zero privileges</span></td>
            </tr>
            <tr>
              <td><code>--uninstall</code></td>
              <td>Cleanly remove helper-configured repositories, packages &amp; integrations</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--no-nautilus</code></td>
              <td>Skip GNOME Files / Nautilus context menu integration</td>
              <td><span class="badge-pill root">Sudo required</span></td>
            </tr>
            <tr>
              <td><code>--dry-run</code></td>
              <td>Simulate installation plan and exit 0 without making system changes</td>
              <td><span class="badge-pill free">Zero privileges</span></td>
            </tr>
            <tr>
              <td><code>-h</code>, <code>--help</code></td>
              <td>Display help text, usage instructions, and examples</td>
              <td><span class="badge-pill free">Zero privileges</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Maintenance & Uninstallation -->
    <section class="doc-section" id="maintenance">
      <h2 class="section-heading"><span>🛠️</span> Maintenance: Status &amp; Clean Uninstallation</h2>
      <p class="section-desc">Our distribution infrastructure is designed to be transparent, auditable, and 100% reversible.</p>

      <div class="doc-card">
        <h3 class="card-subtitle">🔍 Inspect Installation Status</h3>
        <p class="section-desc">Check which applications, versions, repository definitions, GPG keys, and desktop extensions are active on your system (works without sudo):</p>
        <div class="code-block">
          <code>curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --status</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="doc-card">
        <h3 class="card-subtitle">🗑️ Clean Uninstallation</h3>
        <p class="section-desc">Cleanly remove packages via your native package manager (<code>dnf</code> or <code>apt</code>), purge repository definitions, remove GPG keyrings, and delete the Nautilus extension while safely preserving your personal project workspaces in <code>~/.config</code> and <code>$HOME</code>:</p>
        <div class="code-block">
          <code>curl -fsSL https://x3m-industries.github.io/antigravity-packages/install.sh | bash -s -- --uninstall</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Section 3: Manual Repository Configuration -->
    <section class="doc-section" id="manual-repos">
      <h2 class="section-heading"><span>🐧</span> Manual Repository Setup (Without curl scripts)</h2>
      <p class="section-desc">Enterprise environments and security-conscious administrators can configure repositories directly using native system commands.</p>

      <div class="doc-card">
        <h3 class="card-subtitle">Fedora, RHEL, CentOS Stream, Rocky Linux, AlmaLinux (DNF / YUM)</h3>
        <p class="section-desc">1. Add the RPM repository file to <code>/etc/yum.repos.d/</code>:</p>
        <div class="code-block">
          <code>sudo curl -fsSL https://x3m-industries.github.io/antigravity-packages/rpm/antigravity.repo -o /etc/yum.repos.d/antigravity.repo</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
        <p class="section-desc">2. Install the applications:</p>
        <div class="code-block">
          <code>sudo dnf install antigravity-ide antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
        <p class="section-desc">3. Receive automatic updates during your normal system upgrades:</p>
        <div class="code-block">
          <code>sudo dnf update antigravity-ide antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="doc-card">
        <h3 class="card-subtitle">Ubuntu, Debian, Linux Mint, Pop!_OS (APT)</h3>
        <p class="section-desc">1. Add the binary GPG keyring and modern DEB822 repository definition:</p>
        <div class="code-block">
          <code>sudo mkdir -p /etc/apt/keyrings &amp;&amp; sudo curl -fsSL https://x3m-industries.github.io/antigravity-packages/deb/antigravity.gpg -o /etc/apt/keyrings/antigravity.gpg &amp;&amp; sudo curl -fsSL https://x3m-industries.github.io/antigravity-packages/deb/antigravity.sources -o /etc/apt/sources.list.d/antigravity.sources</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
        <p class="section-desc">2. Update index and install packages:</p>
        <div class="code-block">
          <code>sudo apt update &amp;&amp; sudo apt install antigravity-ide antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
        <p class="section-desc">3. Upgrade anytime with:</p>
        <div class="code-block">
          <code>sudo apt update &amp;&amp; sudo apt install --only-upgrade antigravity-ide antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="doc-card">
        <h3 class="card-subtitle">openSUSE Leap &amp; Tumbleweed (Zypper)</h3>
        <p class="section-desc">1. Add repository and import the ASCII-armored GPG key:</p>
        <div class="code-block">
          <code>sudo zypper addrepo -f https://x3m-industries.github.io/antigravity-packages/rpm/ antigravity &amp;&amp; sudo rpm --import https://x3m-industries.github.io/antigravity-packages/rpm/RPM-GPG-KEY-antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
        <p class="section-desc">2. Install packages:</p>
        <div class="code-block">
          <code>sudo zypper install antigravity-ide antigravity</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Section 4: Multi-Desktop File Manager Integrations -->
    <section class="doc-section" id="nautilus">
      <h2 class="section-heading"><span>📂</span> Multi-Desktop File Manager Right-Click Integration</h2>
      <p class="section-desc">The universal installer and native RPM/DEB packages automatically configure native context menus and right-click actions across all major Linux desktop environments:</p>

      <div class="doc-card">
        <h3 class="card-subtitle">GNOME Files (Nautilus) &amp; MATE (Caja)</h3>
        <ul style="margin: 8px 0 16px 20px; color: var(--text-muted); line-height: 1.8;">
          <li><strong>Right-click files or project directories:</strong> Adds <em>"Open in Antigravity IDE"</em>.</li>
          <li><strong>Right-click directory background:</strong> Adds <em>"Open Folder in Antigravity IDE"</em>.</li>
          <li><strong>Compatibility:</strong> Fully supports Nautilus 4.x (GNOME 43+ / GTK4), Nautilus 3.x, and Caja.</li>
          <li><strong>File locations:</strong> <code>/usr/share/nautilus-python/extensions/open-in-antigravity-ide.py</code> and <code>/usr/share/caja-python/extensions/</code>.</li>
        </ul>
        <p class="section-desc">If the context menu does not appear immediately after installation, restart Nautilus:</p>
        <div class="code-block">
          <code>nautilus -q</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="doc-card" style="margin-top: 20px;">
        <h3 class="card-subtitle">KDE Plasma (Dolphin)</h3>
        <p class="section-desc">Configured via native KIO Service Menu (<code>/usr/share/kio/servicemenus/open-in-antigravity-ide.desktop</code>). Right-clicking any folder or file displays <em>"Open in Antigravity IDE"</em> at top level with zero extra Python dependencies.</p>
      </div>

      <div class="doc-card" style="margin-top: 20px;">
        <h3 class="card-subtitle">Linux Mint / Cinnamon (Nemo)</h3>
        <p class="section-desc">Configured via native Nemo Action (<code>/usr/share/nemo/actions/open-in-antigravity-ide.nemo_action</code>). Right-clicking any file or folder in Linux Mint opens it directly in Antigravity IDE.</p>
      </div>

      <div class="doc-card" style="margin-top: 20px;">
        <h3 class="card-subtitle">COSMIC Desktop (Pop!_OS &amp; COSMIC)</h3>
        <p class="section-desc">Full FreeDesktop MIME type integration (<code>inode/directory</code>, <code>application/x-code-workspace</code>) automatically surfaces Antigravity IDE in <strong>cosmic-files</strong> "Open With" menus and enables instant discovery in <strong>cosmic-launcher</strong> search.</p>
      </div>
    </section>

    <!-- Section 5: Arch Linux & Conversion -->
    <section class="doc-section" id="arch">
      <h2 class="section-heading"><span>🏹</span> Arch Linux, Manjaro &amp; EndeavourOS</h2>
      <p class="section-desc">Arch Linux users can install Antigravity by converting our signed Debian packages using <code>debtap</code> or extracting RPMs.</p>

      <div class="doc-card">
        <h3 class="card-subtitle">Converting DEB to Arch Package via debtap</h3>
        <div class="code-block">
          <code>curl -fsSLO https://github.com/x3m-industries/antigravity-packages/releases/latest/download/antigravity-ide_latest_amd64.deb &amp;&amp; debtap -u &amp;&amp; debtap antigravity-ide_latest_amd64.deb &amp;&amp; sudo pacman -U antigravity-ide-*.pkg.tar.zst</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Section 6: Security & GPG Key Verification -->
    <section class="doc-section" id="security">
      <h2 class="section-heading"><span>🔐</span> Security, Trust &amp; Cryptography</h2>
      <p class="section-desc">All packages, repository indices, and release archives are cryptographically signed. We do not recompile or inject code; upstream binaries are pulled directly from Google CDNs.</p>

      <div class="doc-card">
        <h3 class="card-subtitle">Maintainer GPG Identity</h3>
        <ul style="margin: 8px 0 16px 20px; color: var(--text-muted); line-height: 1.8;">
          <li><strong>Key Identity:</strong> <code>{siteConfig.gpg.maintainer}</code></li>
          <li><strong>Key ID:</strong> <code>{siteConfig.gpg.keyId}</code></li>
          <li><strong>Fingerprint:</strong> <code>{siteConfig.gpg.fingerprint}</code></li>
          <li><strong>ASCII Armored Key:</strong> <a href="RPM-GPG-KEY-antigravity" target="_blank" style="color:var(--accent);">/RPM-GPG-KEY-antigravity</a></li>
          <li><strong>Binary Keyring:</strong> <a href="antigravity.gpg" target="_blank" style="color:var(--accent);">/antigravity.gpg</a></li>
        </ul>
        <p class="section-desc">To verify an installed RPM package signature on Fedora / RHEL:</p>
        <div class="code-block">
          <code>rpm -qpi /path/to/antigravity*.rpm | grep -E "Signature|Signer"</code>
          <button class="copy-btn" onclick="copyCode(this)" aria-label="Copy to clipboard" title="Copy to clipboard">
            <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Section 7: Complete FAQ Archive -->
    <section class="doc-section" id="faq">
      <h2 class="section-heading"><span>❓</span> Complete FAQ Archive</h2>
      <p class="section-desc">Frequently asked questions regarding architecture, packaging, sandboxing, and updates.</p>

      {siteConfig.docsFaqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{faq.q}</summary>
          <div class="faq-answer" set:html={faq.a} />
        </details>
      ))}
    </section>
  </main>

  <script is:inline>
    function copyCode(btn) {
      const container = btn.closest('.code-block');
      const codeEl = container ? container.querySelector('code') : null;
      const code = codeEl ? codeEl.innerText.trim() : '';
      if (!code) return;

      navigator.clipboard.writeText(code).then(() => {
        btn.classList.add('copied');
        btn.setAttribute('title', 'Copied to clipboard!');
        btn.setAttribute('aria-label', 'Copied to clipboard!');
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.setAttribute('title', 'Copy to clipboard');
          btn.setAttribute('aria-label', 'Copy to clipboard');
        }, 2000);
      }).catch(err => console.error('Copy failed: ', err));
    }
  </script>
</BaseLayout>
